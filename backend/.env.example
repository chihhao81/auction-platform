# Copy to backend/.env for local development. Never commit real secrets.
APP_ENV=development
PORT=8080
# Neon connection string (use a separate Neon branch for development).
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/critter_bid?sslmode=require
MIGRATE_ON_START=true

# Public origin of the Next.js frontend (it proxies /api and /uploads here).
FRONTEND_URL=http://localhost:3000

# LINE Login. Secrets live only here, never in the frontend.
MOCK_LINE_AUTH=true
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/api/auth/line/callback
# Comma separated LINE user IDs that get the ADMIN role on login.
# In mock mode the LINE user ID is "mock-<name>", e.g. mock-admin.
ADMIN_LINE_USER_IDS=mock-admin

SESSION_TTL=168h
# Defaults to true when APP_ENV=production.
# COOKIE_SECURE=false
# Header holding the client IP when behind a trusted proxy (e.g. X-Forwarded-For).
CLIENT_IP_HEADER=

# Image storage (local disk in development).
UPLOAD_DIR=./uploads

# Scheduler: settles ended auctions, merges orders, sends timed notifications.
SCHEDULER_ENABLED=true
# 1m by default; 5m or 10m on a weak server (jobs are idempotent).
SCHEDULER_INTERVAL=1m

# Web Push. Generate with: go run ./cmd/vapidkeys
# Leave empty to disable push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ECPay (綠界). Payments are disabled while ECPAY_MERCHANT_ID is empty.
# The values below are ECPay's public STAGE test merchant (from their docs);
# replace them with your own merchant in production and never commit real keys.
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_BASE_URL=https://payment-stage.ecpay.com.tw
# Accept stage "simulate paid" notifications (forced false in production).
# ECPAY_ALLOW_SIMULATED=true
# Origin ECPay calls back to (ReturnURL = PUBLIC_BASE_URL/api/payments/ecpay/notify).
# Must be reachable from the internet for callbacks; defaults to FRONTEND_URL.
# Locally the order page falls back to querying ECPay, so callbacks are optional.
# PUBLIC_BASE_URL=https://your-site.example

# Automatic order transitions.
ORDER_AUTO_RECEIVE_AFTER=72h
ORDER_AUTO_COMPLETE_AFTER=168h
# Buyer address is erased this long after the order completes / is cancelled.
SHIPPING_INFO_RETENTION=720h

# Password-protected test accounts for early testing of a deployed site:
# anyone with this password can sign in as "<any name>" (LINE user id
# "test-<name>"). At least 16 characters. Remove before real launch.
# TEST_LOGIN_PASSWORD=
