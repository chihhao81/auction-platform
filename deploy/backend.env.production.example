# /etc/critter-bid/backend.env  (chmod 640, owner root:critterbid)
# Production settings. Never commit the real file.
APP_ENV=production
PORT=8080

# Neon production branch. The pooled host (ep-xxx-pooler) is fine; migrations
# automatically use the direct host.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
MIGRATE_ON_START=true

# Public site (Vercel). The frontend proxies /api to this backend.
FRONTEND_URL=https://app.example.com
PUBLIC_BASE_URL=https://app.example.com

# Early testing without LINE: password-protected test accounts. Sign in with
# any name (e.g. admin, seller, buyer1) + this password. >= 16 characters.
# Remove this line before real launch.
TEST_LOGIN_PASSWORD=

# LINE Login (LINE Developers console -> your Login channel). Optional while
# TEST_LOGIN_PASSWORD is set; all three must be set together.
MOCK_LINE_AUTH=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=https://app.example.com/api/auth/line/callback
# Admins: LINE user IDs, or test-<name> for test accounts (e.g. test-admin).
ADMIN_LINE_USER_IDS=test-admin

SESSION_TTL=168h
COOKIE_SECURE=true
# Header carrying the visitor IP through Vercel -> Caddy (verify after deploy).
CLIENT_IP_HEADER=X-Real-IP

# Images on Cloudflare R2.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=critter-bid-images
R2_PUBLIC_BASE_URL=https://img.example.com

# Web Push: generate with `go run ./cmd/vapidkeys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ECPay production merchant (NOT the public stage test merchant).
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_BASE_URL=https://payment.ecpay.com.tw
ECPAY_ALLOW_SIMULATED=false

# Scheduler (1m by default; 5m/10m if the VM struggles — jobs are idempotent).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=1m
ORDER_AUTO_RECEIVE_AFTER=72h
ORDER_AUTO_COMPLETE_AFTER=168h
SHIPPING_INFO_RETENTION=720h
